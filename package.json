{
  "name": "plexyfin",
  "version": "1.0.0",
  "description": "A self-hosted media server combining the best features of Jellyfin and Plex",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "client": "cd frontend && npm start",
    "build": "cd frontend && npm run build",
    "install-all": "npm install && cd frontend && npm install"
  },
  "keywords": [
    "media-server",
    "streaming",
    "jellyfin",
    "plex",
    "self-hosted"
  ],
  "author": "lori28167",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "fluent-ffmpeg": "^2.1.2",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6",
    "fs-extra": "^11.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
