# Plexyfin Docker Environment
# Copy this file to .env and fill in your values

# Security
JWT_SECRET=your-super-secret-jwt-key-please-change-this

# Media API Keys (optional, for metadata)
TMDB_API_KEY=

# Tunneling (optional, for external access)
ENABLE_TUNNEL=false
TUNNEL_TYPE=cloudflared
CLOUDFLARE_TUNNEL_TOKEN=
NGROK_AUTH_TOKEN=
