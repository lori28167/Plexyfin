# Server Configuration (ATTENTION: Port can be changed but you have to modify it under PUBLIC_URL as well)
PORT=3000
NODE_ENV=production

# JWT Secret (generate a secure random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Media Library Paths (comma-separated)
MEDIA_PATHS=/media/movies,/media/tv-shows,/media/music

# Database
DB_PATH=./data/plexyfin.db

# Transcoding
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
TRANSCODE_TEMP=/tmp/plexyfin-transcode

# Tunneling (optional)
ENABLE_TUNNEL=false
TUNNEL_TYPE=cloudflared
# For cloudflared tunnel
CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
# For ngrok
NGROK_AUTH_TOKEN=your-ngrok-auth-token

# External Access
PUBLIC_URL=http://localhost:3000

# API Keys for metadata (optional)
TMDB_API_KEY=your-tmdb-api-key
TVDB_API_KEY=your-tvdb-api-key
